# Desarrollo: usar proxy de Vite (/api → localhost:8000). Same-origin evita CORS en subidas grandes.
# NO descomentar la línea de abajo (provoca OPTIONS OK pero POST nunca llega con archivos).
# VITE_API_URL=http://localhost:8000/api

# En local no existe el subdominio dashboard.*, así que "Aula Virtual" debe apuntar
# al propio dev server (mismo puerto que server.port en vite.config.js).
VITE_DASHBOARD_URL=http://localhost:3000
